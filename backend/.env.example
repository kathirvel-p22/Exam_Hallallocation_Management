# ═══════════════════════════════════════
# AcadeX Backend Environment Variables
# Copy this file to .env and fill values
# ═══════════════════════════════════════

# ── App ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database (Supabase free tier) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── Redis (Upstash free tier) ──
REDIS_URL="redis://:password@hostname:6379"
# Or for Upstash TLS:
# REDIS_URL="rediss://:password@hostname:6380"

# ── JWT ──
JWT_SECRET=change_this_to_a_very_long_random_secret_minimum_64_chars
JWT_REFRESH_SECRET=another_very_long_random_secret_for_refresh_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Gmail SMTP — Free) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="AcadeX Platform <noreply@acadex.edu>"

# ── Firebase FCM (Free push notifications) ──
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── Groq API (Free LLaMA 3 — AI Chatbot) ──
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ── Cloudinary (25GB free — file storage) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── QR Code ──
QR_TOKEN_SECRET=qr_specific_secret_for_hall_tickets
